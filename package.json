{
  "name": "anisonary",
  "version": "1.31.1",
  "private": true,
  "license": "SEE LICENSE IN LICENSING.md",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/build.mjs",
    "preview": "astro preview",
    "lint": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:built": "ANISONARY_E2E_REUSE_BUILD=true playwright test",
    "catalog:check": "vitest run tests/unit/curated-catalog.test.ts",
    "catalog:stats": "node scripts/catalog-stats.mjs",
    "catalog:stats:update": "node scripts/catalog-stats.mjs --write",
    "catalog:stats:check": "node scripts/catalog-stats.mjs --check",
    "backup": "node scripts/backup-project.mjs",
    "backup:check": "node scripts/backup-project.mjs --check",
    "backup:restore": "node scripts/backup-project.mjs --restore",
    "api:smoke": "vitest run --config vitest.live.config.ts",
    "api:check": "npm run api:smoke && ANISONARY_REQUIRE_API_DATA=true npm run build",
    "public:check": "node scripts/check-public-boundary.mjs",
    "public:artifact-check": "node scripts/check-public-boundary.mjs dist",
    "test:all": "npm test && npm run test:e2e",
    "verify:batch": "node scripts/verify.mjs batch",
    "verify:full": "node scripts/verify.mjs full",
    "check": "npm run verify:full",
    "cf:check": "WRANGLER_SEND_METRICS=false WRANGLER_SEND_ERROR_REPORTS=false WRANGLER_LOG_PATH=/tmp/anisonary-wrangler-logs wrangler deploy --dry-run",
    "cf:dev": "npm run build && WRANGLER_SEND_METRICS=false WRANGLER_SEND_ERROR_REPORTS=false WRANGLER_LOG_PATH=/tmp/anisonary-wrangler-logs wrangler dev",
    "cf:preview": "npm run build && WRANGLER_SEND_METRICS=false WRANGLER_SEND_ERROR_REPORTS=false WRANGLER_LOG_PATH=/tmp/anisonary-wrangler-logs wrangler versions upload",
    "cf:deploy": "npm run build && WRANGLER_SEND_METRICS=false WRANGLER_SEND_ERROR_REPORTS=false WRANGLER_LOG_PATH=/tmp/anisonary-wrangler-logs wrangler deploy"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.8"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "typescript": "^6.0.3",
    "vitest": "~4.1.11",
    "wrangler": "^4.151.0"
  },
  "overrides": {
    "fast-uri": "3.1.8"
  }
}
