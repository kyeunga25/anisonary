---
import { catalogSourceDefinitions } from "@/data/catalog-sources";
import { loadCatalogDirectoryData, loadCatalogSearchData } from "@/data/page-data";
import { getDataProvider, shouldRequireApiData } from "@/data/provider";
import ErrorState from "@/components/common/ErrorState.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { compareSeasonsNewestFirst } from "@/utils/season";

const provider = getDataProvider();
const [directory, catalog] = await Promise.all([
  loadCatalogDirectoryData(provider, shouldRequireApiData()),
  loadCatalogSearchData(provider, shouldRequireApiData())
]);
const seasons = [...directory.seasons].sort(compareSeasonsNewestFirst);
const latest = seasons[0];
const registeredSources = catalogSourceDefinitions.map((source) => ({
  ...source,
  reference: latest?.catalogReferences.find((reference) => reference.id === source.id)
}));
const formatNumber = (value: number) => new Intl.NumberFormat("en-US").format(value);
const themes = catalog.entries.flatMap(({ anime }) => anime.themes);
const videoCount = themes.reduce((total, theme) => total + theme.videos.length, 0);
const themeCounts = [
  ["OP／ED", themes.filter((theme) => theme.type === "OP" || theme.type === "ED").length],
  ["劇中歌", themes.filter((theme) => theme.type === "IN").length],
  ["一般主題歌", themes.filter((theme) => theme.type === "TS").length]
] as const;
const latestVerifiedAt = seasons.map(({ verifiedAt }) => verifiedAt).sort().at(-1);
---

<BaseLayout title="資料來源" description="Anisonary 動畫歌典的資料來源優先級與驗證原則。">
  <article class="prose page-shell">
    <h1>資料來源</h1>
    <p>公開季度目錄以日本官方原始資料為主，並以可追溯的公開頁面交叉確認名稱、季度、播出資訊及主題曲。季度、作品及歌曲都公開來源語言、角色、審閱狀態與核對日期；歌曲按實際已核對證據列出來源；待核項目保留狀態，不把推測當作已確認事實。</p>
    <h2>來源優先級</h2>
    <ol>
      <li>動畫官方網站、唱片公司、藝人官方網站與官方 YouTube；</li>
      <li>Annict 日文季度目錄與結構化資料，用作日本新番全集盤點；</li>
      <li>Bangumi、繁中年度動畫列表與台港正式授權頁，用作缺口、日期與譯名交叉核對；</li>
      <li>AnimeThemes 與季度主題曲清單交叉確認 OP／ED；連結只有指向官方 YouTube 時才標記為官方影片；</li>
      <li>AniList 等國際資料庫只作作品識別、官方網站指標及公開媒體來源。</li>
    </ol>
    <h2>歌曲來源 ledger</h2>
    <p>每筆已發布歌曲用途都會在歌曲卡直接列出可點擊來源。「第一方」表示動畫、發行、藝人、正式播出機構或官方影片頁；「交叉核對」表示公開歌曲／季度索引。這些標籤只描述來源角色，不是分數或信心評級。已確認事實須有相應證據；仍有基本資料或用途季度缺口的既有記錄明示待核狀態，不計作已補齊。</p>
    <h2 id="season-catalogs">固定季度全集參考</h2>
    <p>每個季度頁會由同一份來源 registry 產生對應目錄連結。兩邊只負責盤點和交叉核對；網站使用 repository 內已人工審核的 snapshot，不會在 build 或使用者瀏覽時即時請求外部 API。</p>
    <div class="source-registry">
      {registeredSources.map((source) => (
        <article lang={source.locale === "ja" ? "ja" : "zh-Hant"}>
          <div class="source-registry__heading">
            <span>{source.languageLabel}</span>
            <strong>{source.authMode === "public-read" ? "公開讀取" : "API 需 OAuth"}</strong>
          </div>
          <h3>{source.name}</h3>
          <p>{source.role}</p>
          <dl>
            <div>
              <dt>核對欄位</dt>
              <dd>{source.fields.join("、")}</dd>
            </div>
            <div>
              <dt>使用限制</dt>
              <dd>{source.limitations}</dd>
            </div>
            {source.reference && (
              <div>
                <dt>公開審閱</dt>
                <dd>已審閱 · {source.reference.verifiedAt} · {source.reference.sourceRole === "inventory" ? "全集盤點" : "交叉核對"}</dd>
              </div>
            )}
          </dl>
          {source.reference && (
            <nav aria-label={`${source.name} 固定參考連結`}>
              <a href={source.reference.catalogUrl} target="_blank" rel="noopener noreferrer">{latest && `${latest.year} ${latest.titleZhHant}目錄`} ↗</a>
              <a href={source.documentationUrl} target="_blank" rel="noopener noreferrer">官方 API 文件 ↗</a>
            </nav>
          )}
        </article>
      ))}
    </div>
    <h2>已發布季度與公開快照</h2>
    <p>季度與參考連結沿用網站同一份已審閱快照。各季度可查看盤點範圍、Annict／Bangumi 參考與逐作品來源；目前收錄不代表整季或全部歷史資料已齊備。</p>
    <ul class="published-seasons">{seasons.map((season) => <li>
      <a href={`/seasons/${season.id}/`}>{season.year} {season.titleZhHant}</a>
      <span> · {season.anime.length} 套動畫 · 索引核對：{season.verifiedAt} · </span>
      <a href={`/seasons/${season.id}/anime/`}>動畫海報牆</a>
    </li>)}</ul>
    <p>更新季度資料時，先取多個目錄的聯集找出缺口，再逐套返回動畫官網和台港正式授權來源確認。完整查詢方式、分頁規則與繁中名稱政策記錄在 repository 的 <a href="https://github.com/kyeunga25/anisonary/blob/main/docs/DATA_SOURCES.md" target="_blank" rel="noopener noreferrer">DATA_SOURCES.md</a>；歌曲 ledger 與媒體邊界見 <a href="https://github.com/kyeunga25/anisonary/blob/main/docs/DATA_PROVENANCE.md" target="_blank" rel="noopener noreferrer">DATA_PROVENANCE.md</a>，API、資料規模、媒體及停止條件見 <a href="https://github.com/kyeunga25/anisonary/blob/main/docs/SOURCE_TERMS.md" target="_blank" rel="noopener noreferrer">SOURCE_TERMS.md</a>。</p>
    <h2>圖片原則</h2>
    <p>目錄不使用 AI 生成圖片，也不從動畫官網下載後重新託管素材。首頁識別視覺只使用 HTML／CSS；動畫海報牆與作品詳情的圖像由已核對的 AniList media origin 直接載入，卡片與詳情會顯示公開媒體頁來源；歌曲列表與搜尋不載入作品海報。來源連結提供追溯但不代表本站擁有圖像權利或授予重用權；圖像不進離線 cache，來源無法載入或條款不再容許時只顯示無圖 fallback。</p>
    <h2>目前資料狀態</h2>
    {directory.status === "error" || catalog.status === "error" ? <ErrorState message="目前資料狀態暫時無法取得，請稍後重新載入。" /> : <>
      <p>目錄目前有 {formatNumber(seasons.length)} 個季度快照、{formatNumber(catalog.entries.length)} 個唯一作品頁、{formatNumber(themes.length)} 筆歌曲用途（{themeCounts.map(([label, count]) => `${label} ${formatNumber(count)} 筆`).join("、")}），以及 {formatNumber(videoCount)} 筆官方或正式授權影片 metadata。已核對用途保留第一方與交叉核對證據，其他用途的必需缺口見歌曲資料狀態；用途數不等於唯一歌曲數。</p>
      <p>最新季度索引核對日期為 {latestVerifiedAt ?? "未記錄"}；作品與歌曲的個別核對日期見詳情及來源。可從<a href="/catalog/">季度目錄</a>查看已收錄範圍。</p>
      {seasons.filter(({ coverageNote }) => coverageNote).map((season) => (
        <p><a href={`/seasons/${season.id}/`}>{season.year} {season.titleZhHant}</a>：{season.coverageNote}</p>
      ))}
    </>}
    <p>目前優先整理標準季度 TV 動畫，既有短篇、網絡動畫與特別篇資料及 ID 保留；各季度的實際收錄範圍見上述說明。沒有可靠歌曲證據的作品保留「待核對／待補充」狀態，不將它當成官方未公告或不設 OP／ED。</p>
    <p>如發現播出時間、譯名、主題曲或來源需要修正，可用 <a href="https://github.com/kyeunga25/anisonary/issues/new?template=catalog-correction.yml" target="_blank" rel="noopener noreferrer">GitHub 資料修正表單</a> 提交公開來源。</p>
  </article>
</BaseLayout>

<style>
  .published-seasons { columns: 2 18rem; padding-left: 1.2rem; }
  .published-seasons li { break-inside: avoid; font-size: 0.85rem; }
  .source-registry { display: grid; gap: 1rem; grid-template-columns: repeat(2, minmax(0, 1fr)); margin: 1.5rem 0; }
  .source-registry article { background: var(--color-surface); border: 1px solid var(--color-border-strong); border-radius: var(--radius-control); min-width: 0; padding: 1.2rem; }
  .source-registry__heading { align-items: center; display: flex; gap: 0.75rem; justify-content: space-between; }
  .source-registry__heading span { color: var(--color-muted); font-size: 0.72rem; }
  .source-registry__heading strong { color: var(--color-accent); font-size: 0.68rem; }
  .source-registry h3 { font-size: 1.25rem; margin: 0.35rem 0 0; }
  .source-registry article > p { color: var(--color-muted); font-size: 0.82rem; margin: 0.4rem 0 0; }
  .source-registry dl { border-top: 1px solid var(--color-border); display: grid; gap: 0.8rem; margin: 1rem 0 0; padding-top: 1rem; }
  .source-registry dl div { display: grid; gap: 0.25rem; }
  .source-registry dt { color: var(--color-muted); font-size: 0.68rem; font-weight: 720; }
  .source-registry dd { font-size: 0.76rem; line-height: 1.65; margin: 0; }
  .source-registry nav { display: flex; flex-wrap: wrap; gap: 1rem; margin-top: 1rem; }
  .source-registry nav a { font-size: 0.75rem; font-weight: 720; text-decoration: none; }

  @media (max-width: 680px) {
    .source-registry { grid-template-columns: 1fr; }
  }
</style>
