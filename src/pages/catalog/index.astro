---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ErrorState from "@/components/common/ErrorState.astro";
import { getDataProvider, shouldRequireApiData } from "@/data/provider";
import { loadCatalogDirectoryData } from "@/data/page-data";
import { groupCatalogYears } from "@/utils/catalog-directory";
import "@/styles/catalog.css";

const data = await loadCatalogDirectoryData(getDataProvider(), shouldRequireApiData());
const years = groupCatalogYears(data.seasons);
const decades = [...new Set(years.map(({ year }) => Math.floor(year / 10) * 10))];
const animeCount = new Set(data.seasons.flatMap((season) => season.anime.map((anime) => anime.slug))).size;
const latest = years[0]?.seasons[0];
---
<BaseLayout title="季度目錄｜Browse by season" description="按年份與季度直接打開動畫歌曲列表，查看 OP／ED、演唱者、創作者與官方來源。">
  <div class="catalog-page page-shell">
    <header class="catalog-heading">
      <div>
        <h1>季度目錄</h1>
        <p lang="en">Browse by season</p>
        <p>選一個季度，直接查看歌曲列表。也可以將所有季度放在一起瀏覽。</p>
      </div>
      <div class="catalog-actions">
        <a class="button button--primary" href="/songs/">所有歌曲</a>
        {latest && <a class="button button--outline" href={`/seasons/${latest.id}/`}>最新收錄季度</a>}
      </div>
    </header>
    {data.status === "error" ? <ErrorState message="動畫目錄暫時無法取得，請稍後重新載入。" /> : (
      <>
        <p class="catalog-meta">已發布 {data.seasons.length} 個季度 · {animeCount.toLocaleString("en-US")} 套動畫。只列出已收錄年份與季度。</p>
        {decades.map((decade) => (
          <details class="catalog-decade" open>
            <summary>{decade} 年代 <small>{years.filter(({ year }) => Math.floor(year / 10) * 10 === decade).length} 個年份</small></summary>
            <ul class="catalog-years" aria-label={`${decade} 年代已收錄年份`}>
              {years.filter(({ year }) => Math.floor(year / 10) * 10 === decade).map((entry) => (
                <li><a class="catalog-year-link" href={`/catalog/${entry.year}/`}><strong>{entry.year}</strong><small>{entry.seasons.length} 個季度 · {entry.animeCount} 套動畫</small></a>
                  <div class="catalog-season-links">{entry.seasons.map((season) => <a href={`/seasons/${season.id}/`}><strong>{season.titleZhHant.replace("動畫", "")}</strong><small>{season.anime.reduce((sum, anime) => sum + anime.opCount + anime.edCount, 0)} 首 OP／ED</small></a>)}</div>
                </li>
              ))}
            </ul>
          </details>
        ))}
      </>
    )}
  </div>
</BaseLayout>
