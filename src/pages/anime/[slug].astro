---
import SourceList from "@/components/anime/SourceList.astro";
import Breadcrumbs from "@/components/common/Breadcrumbs.astro";
import MockNotice from "@/components/common/MockNotice.astro";
import PosterImage from "@/components/common/PosterImage.astro";
import ThemeCard from "@/components/theme/ThemeCard.astro";
import ThemeEmptyState from "@/components/theme/ThemeEmptyState.astro";
import { getDataProvider, shouldRequireApiData } from "@/data/provider";
import { loadCatalogSearchData } from "@/data/page-data";
import BaseLayout from "@/layouts/BaseLayout.astro";
import type { PublicAnimeDetail, PublicSeasonSummary } from "@/types/public-api";
import { buildAnimeJsonLd } from "@/utils/seo";
import { animeStatusLabel, themeTypeLabel } from "@/utils/theme";
import { formatBroadcastLabel } from "@/utils/weekday";
import { compareSeasonsNewestFirst } from "@/utils/season";

interface AnimePageProps {
  anime: PublicAnimeDetail;
  season: PublicSeasonSummary;
  seasons: PublicSeasonSummary[];
  isMockData: boolean;
}

export async function getStaticPaths() {
  try {
    const provider = getDataProvider();
    const data = await loadCatalogSearchData(provider, shouldRequireApiData());
    if (data.status === "error") {
      console.error("Anisonary anime data is unavailable; no anime pages were generated.");
      return [];
    }

    return data.entries.map(({ anime, season, seasons, isMockData }) => {
      const memberships = [...seasons].sort(compareSeasonsNewestFirst);
      return { params: { slug: anime.slug }, props: { anime, season: memberships[0] ?? season, seasons: memberships, isMockData } };
    });
  } catch (error) {
    if (shouldRequireApiData()) throw error;
    console.error("Anisonary anime data is unavailable; no anime pages were generated.");
    return [];
  }
}

const { anime, season, seasons, isMockData } = Astro.props as AnimePageProps;
const seasonLabel = `${season.year} ${season.titleZhHant}`;
const broadcastLabel = formatBroadcastLabel(anime);
const pageDescription = anime.themeAvailability === "not_used"
  ? `${anime.titleJa} 經官方正片與製作資料核對，不設獨立 OP／ED；可查看作品資料與驗證來源。`
  : `${anime.titleJa} 的 OP／ED、演唱者、製作 Credits 與已驗證資料來源。`;
const externalReferences = [
  anime.officialSiteUrl && { label: "動畫官方來源", url: anime.officialSiteUrl },
  anime.bangumiUrl && { label: "Bangumi", url: anime.bangumiUrl },
  anime.anilistUrl && { label: "AniList", url: anime.anilistUrl }
].filter((item): item is { label: string; url: string } => Boolean(item));
const site = Astro.site ?? new URL("https://anisonary.k-y.cc");
const catalogCorrectionUrl = new URL("https://github.com/kyeunga25/anisonary/issues/new");
catalogCorrectionUrl.searchParams.set("template", "catalog-correction.yml");
catalogCorrectionUrl.searchParams.set("title", `資料修正：${anime.titleJa}`);
---

<BaseLayout
  title={`${anime.titleJa}／${anime.titleZhHant ?? anime.titleRomaji ?? "主題曲"}`}
  description={pageDescription}
  image={anime.posterUrl}
  ogType="video.tv_show"
  jsonLd={buildAnimeJsonLd(anime, season, site)}
>
  <article class="anime-detail page-shell">
    <Breadcrumbs items={[{ label: "季度目錄", href: "/catalog/" }, { label: String(season.year), href: `/catalog/${season.year}/` }, { label: seasonLabel, href: `/seasons/${season.id}/` }, { label: "動畫與主題曲" }]} />

    <header class:list={["anime-hero", { "anime-hero--no-poster": !anime.posterUrl }]}>
      {anime.posterUrl && (
        <figure class="anime-hero__poster">
          <div class="anime-hero__poster-frame">
            <PosterImage
              src={anime.posterUrl}
              alt={anime.posterAlt}
              width={768}
              height={1152}
              loading="eager"
              fetchpriority="high"
            />
          </div>
          {anime.imageSourceUrl && (
            <figcaption>
              公開視覺來源：
              <a href={anime.imageSourceUrl} target="_blank" rel="noopener noreferrer">
                {anime.imageSourceLabel ?? "來源頁"}<span aria-hidden="true">↗</span>
              </a>
            </figcaption>
          )}
        </figure>
      )}

      <div class="anime-hero__content">
        <h1 lang="ja">{anime.titleJa}</h1>
        {anime.titleZhHant && <p class="anime-hero__zh">{anime.titleZhHant}</p>}
        {anime.titleRomaji && <p class="anime-hero__romaji">{anime.titleRomaji}</p>}

        <dl class="anime-hero__meta">
          <div><dt>季度</dt><dd class="anime-seasons">{seasons.map((membership) => <a href={`/seasons/${membership.id}/`}>{membership.year} {membership.titleZhHant.replace("動畫", "")}</a>)}</dd></div>
          <div><dt>播出</dt><dd>{broadcastLabel}</dd></div>
          <div><dt>狀態</dt><dd>{animeStatusLabel(anime.status)}</dd></div>
          <div><dt>資料審閱</dt><dd>已審閱 · {anime.verifiedAt}</dd></div>
        </dl>

        {isMockData && <MockNotice compact />}

        {externalReferences.length > 0 && (
          <nav class="reference-links" aria-label="作品外部參考">
            {externalReferences.map((reference) => (
              <a href={reference.url} target="_blank" rel="noopener noreferrer">
                {reference.label}<span aria-hidden="true">↗</span>
                <span class="sr-only">（在新分頁開啟外部網站）</span>
              </a>
            ))}
          </nav>
        )}
      </div>
    </header>

    <section class="detail-section" aria-labelledby="themes-title">
      <div class="detail-section__heading"><h2 id="themes-title">全部主題曲 <small lang="en">All themes</small></h2><span>{anime.themes.length} 筆歌曲用途</span></div>
      {anime.themes.length > 0 ? (
        <>
          <nav class="theme-jump-list" aria-label="這部動畫的全部歌曲">{anime.themes.map((theme) => <a href={`#theme-${theme.id}`}><span>{themeTypeLabel(theme)}</span>{theme.titleJa}</a>)}</nav>
          <div>{anime.themes.map((theme) => <ThemeCard theme={theme} />)}</div>
        </>
      ) : (
        <ThemeEmptyState
          seasonId={season.id}
          seasonLabel={seasonLabel}
          themeAvailability={anime.themeAvailability}
        />
      )}
    </section>

    <section class="detail-section" aria-labelledby="sources-title">
      <div class="detail-section__heading">
        <h2 id="sources-title">資料來源</h2>
        {!isMockData && (
          <a class="correction-link" href={catalogCorrectionUrl.toString()} target="_blank" rel="noopener noreferrer">
            回報資料問題 <span aria-hidden="true">↗</span>
          </a>
        )}
      </div>
      {anime.sources.length > 0 ? <SourceList sources={anime.sources} /> : <p class="state-message">資料來源待補充。</p>}
    </section>
  </article>
</BaseLayout>

<style>
  .anime-detail { padding-block: 1.5rem 2rem; }
  .anime-hero { align-items: start; display: grid; gap: 1.5rem; grid-template-columns: 7rem minmax(0, 1fr); }
  .anime-hero--no-poster { grid-template-columns: minmax(0, 1fr); }
  .anime-hero__poster { margin: 0; min-width: 0; }
  .anime-hero__poster-frame { aspect-ratio: 2 / 3; border: 1px solid var(--color-border); border-radius: var(--radius-card); overflow: hidden; }
  .anime-hero__poster figcaption { color: var(--color-muted); font-size: 0.6rem; line-height: 1.5; margin-top: 0.4rem; }
  .anime-hero__poster figcaption a { color: var(--color-accent); text-underline-offset: 0.2em; }
  .anime-hero__content { min-width: 0; }
  .anime-hero__content h1 { font-size: clamp(1.65rem, 3vw, 2.3rem); letter-spacing: -0.04em; line-height: 1.3; margin: 0; overflow-wrap: anywhere; }
  .anime-hero__zh { font-size: 1rem; font-weight: 650; margin: 0.35rem 0 0; }
  .anime-hero__romaji { color: var(--color-muted); font-size: 0.8rem; margin: 0.3rem 0 0; }
  .anime-hero__meta { display: flex; flex-wrap: wrap; gap: 0.4rem 1rem; margin: 0.85rem 0 0; }
  .anime-hero__meta div { align-items: baseline; display: flex; gap: 0.4rem; }
  .anime-hero__meta dt { color: var(--color-muted); font-size: 0.65rem; }
  .anime-hero__meta dd { font-size: 0.75rem; margin: 0; }
  .anime-seasons { display: flex; flex-wrap: wrap; gap: 0.3rem 0.6rem; }
  .anime-seasons a { color: var(--color-ink); text-underline-offset: 0.2em; }
  .reference-links { display: flex; flex-wrap: wrap; gap: 0.4rem 1.2rem; margin-top: 0.8rem; }
  .reference-links a { align-items: center; color: var(--color-accent); display: flex; font-size: 0.75rem; gap: 0.35rem; min-height: 2.3rem; text-decoration: none; }
  .reference-links a:hover { text-decoration: underline; text-underline-offset: 0.2em; }
  .detail-section { border-top: 1px solid var(--color-border); margin-top: 1.6rem; padding-top: 1rem; }
  .detail-section__heading { align-items: center; display: flex; flex-wrap: wrap; gap: 0.5rem 1rem; justify-content: space-between; margin-bottom: 0.7rem; }
  .detail-section h2 { font-size: 1.35rem; margin: 0; }
  .detail-section h2 small { color: var(--color-muted); font-size: 0.75rem; font-weight: 450; margin-left: 0.5rem; }
  .detail-section__heading > span { color: var(--color-muted); font-size: 0.75rem; }
  .theme-jump-list { border-bottom: 1px solid var(--color-border); display: flex; flex-wrap: wrap; gap: 0.5rem 1.3rem; margin-bottom: 1rem; }
  .theme-jump-list a { color: var(--color-ink); font-size: 0.8rem; line-height: 1.5; padding: 0.65rem 0; text-decoration: none; }
  .theme-jump-list span { color: var(--color-accent); margin-right: 0.45rem; }
  .theme-jump-list a:hover { color: var(--color-accent); }
  .correction-link { color: var(--color-accent); font-size: 0.75rem; text-decoration: none; }
  .correction-link:hover { text-decoration: underline; text-underline-offset: 0.2em; }
  @media (max-width: 600px) {
    .anime-hero { gap: 0.85rem; grid-template-columns: 4.5rem minmax(0, 1fr); }
    .anime-hero--no-poster { grid-template-columns: 1fr; }
    .anime-hero__content h1 { font-size: 1.55rem; }
    .anime-hero__poster figcaption { font-size: 0.55rem; }
    .anime-hero__meta { gap: 0.25rem 0.7rem; }
    .anime-hero__meta div { flex-wrap: wrap; }
    .reference-links { gap: 0.25rem 0.8rem; margin-top: 0.4rem; }
  }
</style>
