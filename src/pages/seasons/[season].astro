---
import MockNotice from "@/components/common/MockNotice.astro";
import Breadcrumbs from "@/components/common/Breadcrumbs.astro";
import SongPlaylist from "@/components/playlist/SongPlaylist.astro";
import SeasonCatalogReferences from "@/components/season/SeasonCatalogReferences.astro";
import { getDataProvider, shouldRequireApiData } from "@/data/provider";
import { loadCatalogSearchData, loadCatalogDirectoryData } from "@/data/page-data";
import { buildCatalogSearchIndex, type CatalogSearchIndex } from "@/utils/catalog-search-index";
import BaseLayout from "@/layouts/BaseLayout.astro";
import type { PublicSeasonDetail, PublicSeasonSummary } from "@/types/public-api";
import { buildSeasonJsonLd } from "@/utils/seo";

export async function getStaticPaths() {
  const provider = getDataProvider();
  const [catalog, directory] = await Promise.all([
    loadCatalogSearchData(provider, shouldRequireApiData()),
    loadCatalogDirectoryData(provider, shouldRequireApiData())
  ]);
  if (catalog.status === "error" || directory.status === "error") return [];
  return directory.seasons.map((season) => ({
    params: { season: season.id },
    props: {
      season, siblings: directory.seasons.filter((entry) => entry.year === season.year),
      index: buildCatalogSearchIndex(catalog.entries.filter((entry) => entry.seasons.some((membership) => membership.id === season.id)))
    }
  }));
}
interface Props { season: PublicSeasonDetail; siblings: PublicSeasonSummary[]; index: CatalogSearchIndex; }
const { season, siblings, index } = Astro.props;
const title = `${season.year} ${season.titleZhHant}`;
const site = Astro.site ?? new URL("https://anisonary.k-y.cc");
const otherAnime = index.filter((anime) => !anime.themes.length);
---
<BaseLayout title={title} description={`${title} OP／ED 歌曲列表，在同一行查看歌曲、演唱者與動畫，按播出日、用途及名稱篩選。`} jsonLd={buildSeasonJsonLd(season, site)}>
  <div class="browse-page season-page page-shell">
    <Breadcrumbs items={[{ label: "季度目錄", href: "/catalog/" }, { label: String(season.year), href: `/catalog/${season.year}/` }, { label: season.titleZhHant }]} />
    <header class="page-heading">
      <div><h1>{title}</h1><p>本季歌曲，一行一首。點選歌曲，查看動畫的全部 OP／ED。<span lang="ja"> {season.titleJa}</span></p></div>
      <a class="text-link" href="/songs/">跨季度歌曲列表 <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 5 7 7-7 7" /></svg></a>
    </header>
    <p class="season-review">{season.anime.length} 套動畫 · 已審閱 · {season.verifiedAt}{season.coverageNote && <span> · {season.coverageNote}</span>}</p>
    {season.isMockData && <MockNotice compact />}
    <nav class="playlist-tabs season-siblings" aria-label={`${season.year} 年季度導覽`}>
      {siblings.map((entry) => <a href={`/seasons/${entry.id}/`} aria-current={entry.id === season.id ? "page" : undefined}>{entry.titleZhHant.replace("動畫", "")}</a>)}
      <a href="/catalog/">其他年份</a>
    </nav>
    <SongPlaylist index={index} mode="season" initialSeason={season} initialSort="anime" />
    {otherAnime.length > 0 && <section class="season-other" aria-labelledby="other-anime-title">
      <h2 id="other-anime-title">其他已收錄動畫</h2><p>以下作品未列出獨立主題曲；可進入作品頁查看收錄狀態與來源。</p>
      <ul>{otherAnime.map((anime) => <li><a href={`/anime/${anime.slug}/`}><strong>{anime.titleZhHant ?? anime.titleJa}</strong><small>{anime.availability === "not_used" ? "不設獨立 OP／ED" : "主題曲資料待補充"}</small><span aria-hidden="true">→</span></a></li>)}</ul>
    </section>}
    <SeasonCatalogReferences references={season.catalogReferences} />
  </div>
</BaseLayout>
<style>
  .season-review { color: var(--color-muted); font-size: 0.75rem; line-height: 1.7; margin-block: 0.65rem 0; }
  .season-siblings { margin-block: 1rem 0; }
  .season-other { border-top: 1px solid var(--color-border); margin-top: 1.8rem; padding-top: 1rem; }
  .season-other h2 { font-size: 1.15rem; margin: 0; }
  .season-other > p { color: var(--color-muted); font-size: 0.8rem; line-height: 1.7; }
  .season-other ul { list-style: none; margin: 0; padding: 0; }
  .season-other li { border-top: 1px solid var(--color-border); }
  .season-other a { align-items: center; color: var(--color-ink); display: grid; gap: 0.75rem; grid-template-columns: 1fr auto auto; min-height: 2.75rem; padding: 0.65rem 0; text-decoration: none; }
  .season-other strong { font-size: 0.85rem; font-weight: 550; }
  .season-other small { color: var(--color-muted); font-size: 0.72rem; }
  .season-other a:hover { color: var(--color-accent); }
  @media (max-width: 600px) { .season-other a { grid-template-columns: 1fr auto; } .season-other small { grid-column: 1; grid-row: 2; } .season-other a > span { grid-column: 2; grid-row: 1 / 3; } }
</style>
