---
import ErrorState from "@/components/common/ErrorState.astro";
import MockNotice from "@/components/common/MockNotice.astro";
import SongPlaylist from "@/components/playlist/SongPlaylist.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getDataProvider, shouldRequireApiData } from "@/data/provider";
import { loadCatalogSearchData } from "@/data/page-data";
import { buildCatalogSearchIndex } from "@/utils/catalog-search-index";
import { compareSeasonsNewestFirst } from "@/utils/season";
import { buildWebsiteJsonLd } from "@/utils/seo";

const data = await loadCatalogSearchData(getDataProvider(), shouldRequireApiData());
const seasons = [...new Map(data.entries.flatMap((entry) => entry.seasons).map((season) => [season.id, season])).values()].sort(compareSeasonsNewestFirst);
const current = seasons.find((season) => season.id === (import.meta.env.PUBLIC_DEFAULT_SEASON ?? "2026-summer")) ?? seasons[0];
const previous = current && seasons.find((season) => compareSeasonsNewestFirst(season, current) > 0);
const quickSeasons = [current, previous].filter((season) => season !== undefined);
const entries = data.entries.filter((entry) => entry.seasons.some((season) => quickSeasons.some((quick) => quick.id === season.id)));
const index = buildCatalogSearchIndex(entries);
const site = Astro.site ?? new URL("https://anisonary.k-y.cc");
---
<BaseLayout description="歌曲、演唱者與動畫，一行看清。按季度瀏覽 OP／ED，點選歌曲查看動畫的完整主題曲與官方來源。" jsonLd={buildWebsiteJsonLd(site)}>
  <div class="browse-page page-shell">
    <header class="page-heading">
      <div><h1>動畫歌曲，一覽即見。</h1><p>歌曲、演唱者與動畫，一行看清。點選歌曲，查看完整 OP／ED 與官方來源。</p></div>
      <a class="text-link" href="/songs/">瀏覽所有歌曲 <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 5 7 7-7 7" /></svg></a>
    </header>
    {data.status === "error" ? <ErrorState message="季度與動畫資料暫時無法取得。網站其他說明頁仍可正常瀏覽，請稍後重新載入。" /> : <>
      {entries.some((entry) => entry.isMockData) && <MockNotice compact />}
      <SongPlaylist index={index} mode="home" initialSeason={current} quickSeasons={quickSeasons} initialSort="anime" />
      <div class="browse-footer-links"><a href="/catalog/">按年份與季度瀏覽</a><a href="/search/">搜尋動畫、歌曲與創作者</a></div>
    </>}
  </div>
</BaseLayout>
