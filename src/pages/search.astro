---
import ErrorState from "@/components/common/ErrorState.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getDataProvider, shouldRequireApiData } from "@/data/provider";
import { loadCatalogSearchData } from "@/data/page-data";
import { buildCatalogSearchIndex, serializeCatalogSearchIndex } from "@/utils/catalog-search-index";
import { MAX_CATALOG_QUERY_LENGTH } from "@/utils/creator-search";

const data = await loadCatalogSearchData(getDataProvider(), shouldRequireApiData());
const index = buildCatalogSearchIndex(data.entries);
const serialized = serializeCatalogSearchIndex(index);
const years = [...new Set(index.flatMap((anime) => anime.seasons.map((season) => season.year)))].sort((a, b) => b - a);
const themeCount = index.reduce((total, anime) => total + anime.themes.length, 0);
---
<BaseLayout title="跨季度搜尋｜Catalogue Search" description="搜尋動畫、OP／ED、歌手與創作者，按年份、季度及歌曲用途篩選。搜尋字詞只留在瀏覽器。">
  <div class="catalog-search page-shell" data-catalog-search>
    <header class="catalog-search__header">
      <div><h1>跨季度搜尋</h1><p lang="en">Anime · Songs · Creators</p></div>
      <p>輸入動畫、歌名或創作者，用篩選縮小範圍。點選歌曲可查看製作名單與來源。<br /><a class="catalog-search__browse" href="/catalog/">按年份瀏覽動畫目錄</a></p>
    </header>
    {data.status === "error" ? <ErrorState message="搜尋目錄暫時無法取得。其他公開頁面仍可正常瀏覽。" /> : (
      <section class="catalog-search__workspace" aria-labelledby="catalog-search-label">
        <form class="catalog-search__form" role="search" data-catalog-search-form>
          <label id="catalog-search-label" for="catalog-query">搜尋動畫、歌曲或創作者</label>
          <div class="catalog-search__control">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" /><path d="m15.5 15.5 5 5" /></svg>
            <input id="catalog-query" type="search" placeholder="例如：幼女 myth、片頭曲 ReoNa" maxlength={MAX_CATALOG_QUERY_LENGTH} autocomplete="off" autocapitalize="off" spellcheck="false" aria-describedby="catalog-search-privacy catalog-search-summary" data-catalog-search-input />
            <button type="button" data-catalog-search-clear disabled>重設</button>
          </div>
          <div class="catalog-search__filters">
            <div><label for="catalog-scope">搜尋範圍</label><select id="catalog-scope"><option value="all">全部資料</option><option value="anime">動畫名稱</option><option value="songs">歌曲名稱</option><option value="creators">歌手與創作者</option></select></div>
            <div><label for="catalog-year">年份</label><select id="catalog-year"><option value="">全部年份</option>{years.map((year) => <option value={year}>{year}</option>)}</select></div>
            <div><label for="catalog-quarter">季度</label><select id="catalog-quarter"><option value="">全部季度</option><option value="winter">冬季</option><option value="spring">春季</option><option value="summer">夏季</option><option value="fall">秋季</option></select></div>
            <div><label for="catalog-type">歌曲用途</label><select id="catalog-type"><option value="all">全部 OP／ED</option><option value="OP">片頭曲 OP</option><option value="ED">片尾曲 ED</option></select></div>
          </div>
          <p id="catalog-search-privacy" class="catalog-search__privacy">Local-only search · 本站不傳送或儲存搜尋字詞，不載入第三方圖片。</p>
        </form>
        <noscript><p>搜尋需要 JavaScript。你仍可<a href="/catalog/">按年份與季度瀏覽全部動畫</a>。</p></noscript>
        <p id="catalog-search-summary" class="catalog-search__summary" aria-live="polite">找到 <strong data-catalog-anime-count>{index.length}</strong> 套動畫、<strong data-catalog-theme-count>{themeCount}</strong> 筆主題曲</p>
        <p class="catalog-search__empty" data-catalog-search-empty hidden>找不到符合的動畫或歌曲。可重設篩選，或改用日文、繁體中文、羅馬字與其他名稱；未收錄季度不會顯示結果。</p>
        <div class="catalog-search__results" id="catalog-search-results" tabindex="-1" aria-label="搜尋結果"></div>
        <nav class="catalog-search__pagination" aria-label="搜尋結果分頁" data-search-pagination hidden>
          <button type="button" data-search-previous>上一頁</button><p aria-live="polite" data-search-page></p><button type="button" data-search-next>下一頁</button>
        </nav>
        <script is:inline type="application/json" data-search-index set:html={serialized} />
      </section>
    )}
  </div>
</BaseLayout>
<script>
  import "@/scripts/catalog-search";
</script>

<style is:global>
  .catalog-search { padding-block: clamp(2rem, 5vw, 4rem); }
  .catalog-search__header { align-items: end; display: grid; gap: 1.5rem 3rem; grid-template-columns: minmax(17rem, 0.9fr) minmax(20rem, 1.1fr); }
  .catalog-search__header h1 { font-size: clamp(2rem, 4vw, 3.3rem); letter-spacing: -0.055em; line-height: 1.2; margin: 0; }
  .catalog-search__header div > p { color: var(--color-accent); font-size: 0.78rem; font-weight: 760; letter-spacing: 0.12em; margin: 1rem 0 0; text-transform: uppercase; }
  .catalog-search__header > p { color: var(--color-muted); font-size: 0.95rem; line-height: 1.8; margin: 0; max-width: 43rem; }
  .catalog-search__workspace { margin-top: 2rem; }

  .catalog-search__form { border-block: 1px solid var(--color-border-strong); padding-block: 1.4rem; }
  .catalog-search__form > label { display: block; font-size: 0.78rem; font-weight: 760; margin-bottom: 0.65rem; }
  .catalog-search__control { align-items: center; display: grid; gap: 0.8rem; grid-template-columns: auto 1fr auto; }
  .catalog-search__control > svg { fill: none; height: 1.35rem; stroke: var(--color-muted); stroke-linecap: round; stroke-width: 1.7; width: 1.35rem; }
  .catalog-search__control input { background: transparent; border: 0; color: var(--color-ink); font-size: clamp(1rem, 2vw, 1.4rem); font-weight: 650; min-width: 0; outline: 0; padding: 0.35rem 0; width: 100%; }
  .catalog-search__control input::placeholder { color: color-mix(in srgb, var(--color-muted) 72%, transparent); }
  .catalog-search__control input:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 4px; }
  .catalog-search__control button { background: transparent; border: 0; color: var(--color-accent); cursor: pointer; font-size: 0.82rem; font-weight: 720; padding: 0.7rem; }
  .catalog-search__control button:disabled { color: var(--color-muted); cursor: default; opacity: 0.5; }
  .catalog-search__privacy { align-items: center; color: var(--color-muted); display: flex; font-size: 0.72rem; gap: 0.45rem; margin: 0.8rem 0 0 2.15rem; }
  .catalog-search__privacy svg { fill: none; height: 0.95rem; stroke: currentColor; stroke-width: 1.4; width: 0.95rem; }
  .catalog-search__summary { color: var(--color-muted); font-size: 0.8rem; margin: 1.2rem 0 2.4rem; text-align: right; }
  .catalog-search__summary strong { color: var(--color-ink); }
  .catalog-search__empty { border-block: 1px solid var(--color-border); color: var(--color-muted); line-height: 1.8; margin: 0; padding: 3rem 0; text-align: center; }

  .catalog-result { border-top: 1px solid var(--color-border-strong); padding: 1.25rem 0; }
  .catalog-result:last-child { border-bottom: 1px solid var(--color-border-strong); }
  .catalog-result__heading { align-items: start; display: grid; gap: 2rem; grid-template-columns: 1fr auto; }
  .catalog-result__season { color: var(--color-accent); font-size: 0.72rem; font-weight: 760; letter-spacing: 0.06em; text-decoration: none; }
  .catalog-result h2 { font-size: clamp(1.1rem, 2.3vw, 1.5rem); line-height: 1.25; margin: 0.55rem 0 0; }
  .catalog-result h2 a { color: var(--color-ink); text-decoration: none; }
  .catalog-result h2 a:hover, .catalog-result__season:hover { color: var(--color-accent); }
  .catalog-result__heading div > p { color: var(--color-muted); font-size: 0.8rem; margin: 0.42rem 0 0; }
  .catalog-result__open { align-items: center; border-bottom: 1px solid var(--color-ink); color: var(--color-ink); display: inline-flex; font-size: 0.8rem; font-weight: 720; gap: 0.7rem; padding: 0.45rem 0; text-decoration: none; white-space: nowrap; }
  .catalog-result__open:hover { border-color: var(--color-accent); color: var(--color-accent); }
  .catalog-result__open svg { fill: none; height: 1rem; stroke: currentColor; stroke-linecap: round; stroke-linejoin: round; stroke-width: 1.5; width: 1rem; }
  .catalog-result__pending { color: var(--color-muted); font-size: 0.84rem; margin: 1.6rem 0 0; }

  .theme-index { display: grid; list-style: none; margin: 1rem 0 0; padding: 0; }
  .theme-index li { align-items: baseline; border-top: 1px solid var(--color-border); display: grid; gap: 1rem; grid-template-columns: 3.3rem minmax(0, 1.4fr) minmax(0, 1fr); padding: 0.65rem 0; }
  .theme-index__type { color: var(--color-accent); font-size: 0.72rem; font-weight: 780; }
  .theme-index__title { font-size: 0.9rem; font-weight: 720; }
  .theme-index__artist { color: var(--color-muted); font-size: 0.82rem; }

  @media (max-width: 720px) {
    .catalog-search__header { align-items: start; grid-template-columns: 1fr; }
    .catalog-search__header > p { max-width: 36rem; }
    .catalog-search__privacy { align-items: flex-start; margin-left: 0; }
    .catalog-search__summary { text-align: left; }
    .catalog-result__heading { grid-template-columns: 1fr; }
    .catalog-result__open { justify-self: start; }
    .theme-index li { grid-template-columns: 3.2rem 1fr; }
    .theme-index__artist { grid-column: 2; }
  }

  .catalog-search__filters { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0.85rem; margin-top: 1.25rem; }
  .catalog-search__filters label { color: var(--color-muted); font-size: 0.78rem; font-weight: 650; }
  .catalog-search__filters select { background: var(--color-surface); border: 1px solid var(--color-border-strong); border-radius: var(--radius-control); color: var(--color-ink); display: block; font-size: 0.9rem; min-height: 2.8rem; padding: 0.5rem; width: 100%; margin-top: 0.4rem; }
  .catalog-search__browse { color: var(--color-accent); text-underline-offset: 0.2em; }
  .catalog-search__results { scroll-margin-top: 6rem; }
  .catalog-result__identity { min-width: 0; }
  .catalog-result h2, .theme-index__title, .theme-index__artist, .theme-index__credits { overflow-wrap: anywhere; }
  .theme-index__title { color: var(--color-ink); text-underline-offset: 0.2em; }
  .theme-index__title:hover { color: var(--color-accent); }
  .theme-index__credits { color: var(--color-muted); font-size: 0.75rem; line-height: 1.6; grid-column: 2 / -1; }
  .catalog-search__pagination { align-items: center; display: flex; flex-wrap: wrap; justify-content: center; gap: 1rem; padding-block: 1.5rem; }
  .catalog-search__pagination button { background: var(--color-surface); border: 1px solid var(--color-border-strong); border-radius: var(--radius-control); color: var(--color-ink); cursor: pointer; font-size: 0.9rem; min-height: 2.75rem; padding: 0.5rem 1rem; }
  .catalog-search__pagination button:disabled { opacity: 0.45; cursor: default; }
  .catalog-search__pagination p { color: var(--color-muted); font-size: 0.8rem; text-align: center; }
  @media (max-width: 720px) { .catalog-search__filters { grid-template-columns: repeat(2, minmax(0, 1fr)); } .catalog-result__heading { gap: 0.8rem; } }
  @media (max-width: 420px) { .catalog-search__pagination p { flex-basis: 100%; order: -1; } }
</style>
