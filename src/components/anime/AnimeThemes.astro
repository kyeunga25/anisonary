---
import ThemeCard from "@/components/theme/ThemeCard.astro";
import ThemeEmptyState from "@/components/theme/ThemeEmptyState.astro";
import type { PublicAnimeDetail } from "@/types/public-api";
import { themeTypeLabel } from "@/utils/theme";
interface Props { anime: PublicAnimeDetail; seasonId: string; seasonLabel: string; }
const { anime, seasonId, seasonLabel } = Astro.props;
---
    <section class="detail-section" aria-labelledby="themes-title" data-anime-themes>
      <div class="detail-section__heading"><h2 id="themes-title">全部主題曲 <small lang="en">All themes</small></h2><span>{anime.themes.length} 筆歌曲用途</span></div>
      {anime.themes.length > 0 ? (
        <>
          <p class="themes-intro">歌曲、演唱者、創作名單、音源與來源直接展開；可從曲目導覽跳到指定歌曲。</p>
          {anime.themes.length > 6 && (
            <form class="theme-filter" role="search" aria-label="這部動畫的歌曲" data-theme-filter hidden>
              <label>找這部動畫的歌曲<input type="search" maxlength="80" autocomplete="off" placeholder="歌名、演唱者、創作者…" data-theme-query /></label>
              <label>歌曲用途<select data-theme-type-filter><option value="all">全部用途</option>{[...new Set(anime.themes.map((theme) => theme.type))].map((type) => <option value={type}>{type === "IN" ? "劇中歌" : type === "TS" ? "主題歌" : type}</option>)}</select></label>
              <button type="reset" class="button button--outline">重設</button>
              <p role="status" data-theme-filter-count>顯示 {anime.themes.length}／{anime.themes.length} 筆用途</p>
            </form>
          )}
          <p class="state-message" data-theme-filter-empty hidden>找不到符合的歌曲。可改用其他名稱，或重設篩選。</p>
          <nav class="theme-jump-list" aria-label="這部動畫的全部歌曲">{anime.themes.map((theme) => <a href={`#theme-${theme.id}`} data-theme-jump={theme.id}><span>{themeTypeLabel(theme)}</span>{theme.titleJa}</a>)}</nav>
          <div>{anime.themes.map((theme) => <ThemeCard theme={theme} />)}</div>
        </>
      ) : (
        <ThemeEmptyState
          seasonId={seasonId}
          seasonLabel={seasonLabel}
          themeAvailability={anime.themeAvailability}
        />
      )}
    </section>

<script>import "@/scripts/anime-themes";</script>
<style>
  .detail-section { border-top: 1px solid var(--color-border); margin-top: 1.6rem; padding-top: 1rem; }
  .detail-section__heading { align-items: center; display: flex; flex-wrap: wrap; gap: 0.5rem 1rem; justify-content: space-between; margin-bottom: 0.7rem; }
  h2 { font-size: 1.35rem; margin: 0; }
  h2 small { color: var(--color-muted); font-size: 0.75rem; font-weight: 450; margin-left: 0.5rem; }
  .detail-section__heading > span { color: var(--color-muted); font-size: 0.75rem; }
  .theme-jump-list { border-bottom: 1px solid var(--color-border); display: flex; flex-wrap: wrap; gap: 0.5rem 1.3rem; margin-bottom: 1rem; }
  .theme-jump-list a { color: var(--color-ink); font-size: 0.8rem; line-height: 1.5; padding: 0.65rem 0; text-decoration: none; }
  .theme-jump-list span { color: var(--color-accent); margin-right: 0.45rem; }
  .theme-jump-list a:hover { color: var(--color-accent); }
  .themes-intro { color: var(--color-muted); font-size: 0.78rem; line-height: 1.8; margin: 0 0 0.7rem; }
  .theme-filter { align-items: end; background: var(--color-subtle); border: 1px solid var(--color-border); border-radius: var(--radius-control); display: flex; flex-wrap: wrap; gap: 0.7rem; margin-block: 1rem; padding: 0.8rem; }
  .theme-filter[hidden] { display: none; }
  .theme-filter label { color: var(--color-muted); display: grid; font-size: 0.72rem; gap: 0.35rem; }
  .theme-filter label:first-child { flex: 1 1 15rem; }
  .theme-filter input, .theme-filter select { background: var(--color-surface); border: 1px solid var(--color-border-strong); border-radius: var(--radius-control); color: var(--color-ink); font: inherit; font-size: 0.85rem; min-height: 2.75rem; min-width: 0; padding: 0.5rem 0.7rem; width: 100%; }
  .theme-filter p { color: var(--color-muted); flex-basis: 100%; font-size: 0.72rem; margin: 0; }
</style>
