---
import type { PublicVideo } from "@/types/public-api";
import { videoTypeLabel, youtubeEmbedUrl, youtubeWatchUrl } from "@/utils/youtube";

interface Props { video: PublicVideo; }
const { video } = Astro.props;
const embedUrl = youtubeEmbedUrl(video.youtubeVideoId);
const watchUrl = youtubeWatchUrl(video.youtubeVideoId);
const canEmbed = video.embeddable && embedUrl;
---

<div class:list={["youtube-media", { "youtube-media--fallback": !canEmbed }]} data-youtube-player>
  {canEmbed ? (
    <div class="youtube-media__layout">
      <div class="youtube-media__frame" data-youtube-frame aria-busy="false">
        <button
          class="youtube-media__load"
          type="button"
          data-youtube-load
          data-embed-url={embedUrl}
          data-video-title={video.title}
          aria-label={`載入 YouTube 影片：${video.title}`}
        >
          <span class="youtube-media__button-text">載入 YouTube 影片</span>
          <span class="youtube-media__consent">點選後連接 YouTube · Load on request</span>
        </button>
      </div>
      <p class="sr-only" aria-live="polite" data-youtube-status></p>

      <div class="youtube-media__details">
        <dl>
          <div><dt>影片類型</dt><dd>{videoTypeLabel(video.type)}</dd></div>
          <div><dt>頻道</dt><dd>{video.channelName}</dd></div>
          <div><dt>狀態</dt><dd>{video.officialStatus === "official" ? "官方影片" : "授權影片"}</dd></div>
        </dl>
        {watchUrl && <a class="youtube-media__external" href={watchUrl} target="_blank" rel="noopener noreferrer external">在 YouTube 開啟<span class="sr-only">（在新分頁開啟外部網站）</span><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M7 4h9v9M16 4 4 16" /></svg></a>}
      </div>
    </div>
  ) : (
    <div class="youtube-media__fallback-row">
      <span class="youtube-media__unavailable">
        <svg viewBox="0 0 28 28" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2" /><path d="m10 10 6 3-6 3v-6ZM18 19l7 7M25 19l-7 7" /></svg>
        {watchUrl ? (video.embedAvailability === "unknown" ? "嵌入狀態待確認；提供官方外連" : "此官方影片不可嵌入") : "影片 ID 無效，無法載入"}
      </span>
      {watchUrl && <a class="youtube-media__external" href={watchUrl} target="_blank" rel="noopener noreferrer external">在 YouTube 開啟<span class="sr-only">（在新分頁開啟外部網站）</span><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M7 4h9v9M16 4 4 16" /></svg></a>}
    </div>
    <p class="youtube-media__fallback-caption">{video.title} · {videoTypeLabel(video.type)} · {video.channelName}</p>
  )}
</div>

<script>
  document.querySelectorAll<HTMLButtonElement>("[data-youtube-load]").forEach((button) => {
    if (button.dataset.ready === "true") return;
    button.dataset.ready = "true";
    button.addEventListener("click", () => {
      const frame = button.closest<HTMLElement>("[data-youtube-frame]");
      const player = button.closest<HTMLElement>("[data-youtube-player]");
      const status = player?.querySelector<HTMLElement>("[data-youtube-status]");
      const embedUrl = button.dataset.embedUrl;
      const title = button.dataset.videoTitle;
      if (!frame || !embedUrl || !title) return;

      frame.setAttribute("aria-busy", "true");
      if (status) status.textContent = `正在載入 YouTube 影片：${title}`;

      const iframe = document.createElement("iframe");
      iframe.src = embedUrl;
      iframe.title = `YouTube 影片：${title}`;
      iframe.loading = "lazy";
      iframe.allow = "accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share";
      // YouTube requires an origin-level Referer for embedded-player identity.
      // Keep the site-wide no-referrer policy for every other remote request.
      iframe.referrerPolicy = "strict-origin-when-cross-origin";
      iframe.setAttribute("allowfullscreen", "");
      iframe.addEventListener("load", () => {
        frame.setAttribute("aria-busy", "false");
        if (status) status.textContent = `YouTube 影片已載入：${title}`;
      }, { once: true });
      frame.replaceChildren(iframe);
    }, { once: true });
  });
</script>

<style>
  .youtube-media { background: var(--color-subtle); border: 1px solid var(--color-border); border-radius: var(--radius-control); padding: 0.75rem 1rem; }
  .youtube-media + .youtube-media { margin-top: 0.6rem; }
  .youtube-media__layout { align-items: center; display: grid; gap: 1rem; grid-template-columns: auto minmax(0, 1fr); }
  .youtube-media__frame { border-radius: var(--radius-control); overflow: hidden; }
  .youtube-media__frame:has(iframe) { aspect-ratio: 16 / 9; background: #07143f; width: 100%; }
  .youtube-media__frame :global(iframe) { border: 0; height: 100%; width: 100%; }
  .youtube-media__layout:has(iframe) { grid-template-columns: minmax(0, 1fr); }
  .youtube-media__load { align-items: center; background: transparent; border: 1px solid var(--color-accent); border-radius: var(--radius-control); color: var(--color-accent); cursor: pointer; display: flex; flex-direction: column; gap: 0.3rem; min-height: 3.3rem; padding: 0.5rem 1rem; width: 100%; }
  .youtube-media__load:hover { background: color-mix(in srgb, var(--color-accent) 8%, transparent); }
  .youtube-media__button-text { font-size: 0.85rem; font-weight: 650; }
  .youtube-media__consent { color: var(--color-muted); font-size: 0.65rem; }
  .youtube-media__details { align-items: center; display: flex; flex-wrap: wrap; gap: 0.5rem 1rem; justify-content: space-between; }
  .youtube-media__details dl { display: flex; flex-wrap: wrap; gap: 0.4rem 1rem; margin: 0; }
  .youtube-media__details dl div { display: flex; flex-wrap: wrap; gap: 0.35rem; }
  .youtube-media__details dt { color: var(--color-muted); font-size: 0.68rem; }
  .youtube-media__details dd { font-size: 0.75rem; margin: 0; }
  .youtube-media__external { align-items: center; color: var(--color-accent); display: inline-flex; font-size: 0.75rem; gap: 0.4rem; min-height: 2.3rem; text-decoration: none; }
  .youtube-media__external:hover { text-decoration: underline; text-underline-offset: 0.2em; }
  .youtube-media__external svg { fill: none; height: 0.8rem; stroke: currentColor; stroke-width: 1.6; width: 0.8rem; }
  .youtube-media__fallback-row { align-items: center; display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; justify-content: space-between; }
  .youtube-media__unavailable { align-items: center; display: flex; font-size: 0.8rem; gap: 0.5rem; }
  .youtube-media__unavailable svg { fill: none; flex: none; height: 1.1rem; stroke: var(--color-muted); stroke-linecap: round; stroke-width: 1.5; width: 1.1rem; }
  .youtube-media__fallback-caption { color: var(--color-muted); font-size: 0.75rem; line-height: 1.6; margin: 0.4rem 0 0; overflow-wrap: anywhere; }
  @media (max-width: 600px) {
    .youtube-media__layout { grid-template-columns: 1fr; gap: 0.5rem; }
    .youtube-media__details dl { gap: 0.3rem 0.8rem; }
  }
</style>
