---
import Logo from "@/components/common/Logo.astro";
import ThemeToggle from "@/components/common/ThemeToggle.astro";

const pathname = Astro.url.pathname;
const navigationGroups = [
  {
    id: "explore",
    label: "探索",
    links: [
      { href: "/", label: "首頁" },
      { href: "/search/", label: "搜尋" }
    ]
  },
  {
    id: "seasons",
    label: "季度",
    sections: [
      {
        label: "2026",
        links: [
          { href: "/seasons/2026-summer/", label: "夏季" },
          { href: "/seasons/2026-spring/", label: "春季" },
          { href: "/seasons/2026-winter/", label: "冬季" }
        ]
      },
      {
        label: "2025",
        links: [
          { href: "/seasons/2025-summer/", label: "夏季" },
          { href: "/seasons/2025-spring/", label: "春季" },
          { href: "/seasons/2025-winter/", label: "冬季" }
        ]
      },
      {
        label: "2024",
        links: [
          { href: "/seasons/2024-fall/", label: "秋季" },
          { href: "/seasons/2024-summer/", label: "夏季" },
          { href: "/seasons/2024-spring/", label: "春季" }
        ]
      }
    ]
  },
  {
    id: "information",
    label: "資訊",
    links: [
      { href: "/sources/", label: "資料來源" },
      { href: "/about/", label: "關於" }
    ]
  }
];

const isActive = (href: string) => {
  if (href === "/") return pathname === "/";
  const base = href.replace(/\/$/, "");
  return pathname === base || pathname.startsWith(`${base}/`);
};
---

<header class="site-header">
  <div class="site-header__inner">
    <Logo />
    <nav class="site-nav" id="site-navigation" aria-label="主要導覽" data-site-navigation data-open="false">
      {navigationGroups.map((group) => (
        <div class="site-nav__group">
          <p class="site-nav__label" id={`site-nav-${group.id}`}>{group.label}</p>
          {"sections" in group ? group.sections.map((section) => (
            <div class="site-nav__year-group">
              <p class="site-nav__year" id={`site-nav-${group.id}-${section.label}`}>{section.label}</p>
              <ul aria-labelledby={`site-nav-${group.id}-${section.label}`}>
                {section.links.map((link) => (
                  <li>
                    <a href={link.href} aria-current={isActive(link.href) ? "page" : undefined}>{link.label}</a>
                  </li>
                ))}
              </ul>
            </div>
          )) : (
            <ul aria-labelledby={`site-nav-${group.id}`}>
              {group.links.map((link) => (
                <li>
                  <a href={link.href} aria-current={isActive(link.href) ? "page" : undefined}>{link.label}</a>
                </li>
              ))}
            </ul>
          )}
        </div>
      ))}
    </nav>
    <div class="site-header__actions">
      <ThemeToggle />
      <button
        class="site-menu-toggle"
        type="button"
        aria-label="選單"
        aria-controls="site-navigation"
        aria-expanded="false"
        data-menu-toggle
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" />
        </svg>
        <span>選單</span>
      </button>
    </div>
  </div>
</header>

<script>
  document.querySelectorAll<HTMLElement>(".site-header").forEach((header) => {
    const button = header.querySelector<HTMLButtonElement>("[data-menu-toggle]");
    const navigation = header.querySelector<HTMLElement>("[data-site-navigation]");

    if (!button || !navigation || button.dataset.ready === "true") return;
    button.dataset.ready = "true";

    const setOpen = (open: boolean, restoreFocus = false) => {
      button.setAttribute("aria-expanded", String(open));
      navigation.dataset.open = String(open);
      if (restoreFocus) button.focus();
    };

    button.addEventListener("click", () => {
      setOpen(button.getAttribute("aria-expanded") !== "true");
    });

    navigation.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => setOpen(false));
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && button.getAttribute("aria-expanded") === "true") {
        setOpen(false, true);
      }
    });

    document.addEventListener("click", (event) => {
      if (button.getAttribute("aria-expanded") === "true" && !header.contains(event.target as Node)) {
        setOpen(false);
      }
    });

    window.matchMedia("(min-width: 960px)").addEventListener("change", () => setOpen(false));
  });
</script>

<style>
  .site-header {
    align-self: start;
    background: var(--color-canvas);
    border-right: 1px solid var(--color-border);
    height: 100vh;
    height: 100dvh;
    position: sticky;
    top: 0;
    z-index: 20;
  }

  .site-header__inner {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 1.5rem 1.15rem 1.25rem;
  }

  .site-nav {
    display: grid;
    gap: 1.7rem;
    margin-top: 2.75rem;
    overflow-y: auto;
    padding-right: 0.2rem;
  }

  .site-nav__label {
    color: var(--color-muted);
    font-size: 0.68rem;
    font-weight: 760;
    letter-spacing: 0.13em;
    margin: 0 0 0.5rem;
  }

  .site-nav ul {
    display: grid;
    gap: 0.15rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-nav__year-group + .site-nav__year-group { margin-top: 0.7rem; }

  .site-nav__year {
    color: var(--color-muted);
    font-size: 0.66rem;
    font-variant-numeric: tabular-nums;
    font-weight: 720;
    letter-spacing: 0.08em;
    margin: 0 0 0.15rem 0.78rem;
  }

  .site-nav a {
    border-left: 2px solid transparent;
    color: var(--color-muted);
    display: block;
    font-size: 0.9rem;
    font-weight: 680;
    padding: 0.62rem 0.75rem;
    position: relative;
    text-decoration: none;
    transition: background-color 160ms ease, border-color 160ms ease, color 160ms ease;
  }

  .site-nav a:hover {
    background: var(--color-subtle);
    color: var(--color-ink);
  }

  .site-nav a[aria-current="page"] {
    background: color-mix(in srgb, var(--color-accent) 9%, transparent);
    border-left-color: var(--color-accent);
    color: var(--color-accent);
  }

  .site-header__actions {
    align-items: center;
    border-top: 1px solid var(--color-border);
    display: flex;
    margin-top: auto;
    padding-top: 1rem;
  }

  .site-menu-toggle { display: none; }

  @media (max-width: 959px) {
    .site-header {
      backdrop-filter: blur(14px);
      background: color-mix(in srgb, var(--color-canvas) 94%, transparent);
      border-bottom: 1px solid var(--color-border);
      border-right: 0;
      height: auto;
      width: 100%;
    }

    .site-header__inner {
      align-items: center;
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      height: auto;
      min-height: 4.5rem;
      padding: 0.55rem var(--page-gutter);
    }

    .site-nav {
      background: var(--color-canvas);
      border-bottom: 1px solid var(--color-border);
      box-shadow: 0 1.2rem 2.4rem color-mix(in srgb, var(--color-ink) 12%, transparent);
      display: none;
      gap: 1.35rem;
      grid-column: 1 / -1;
      grid-row: 2;
      left: 0;
      margin: 0;
      max-height: calc(100vh - 4.5rem);
      max-height: calc(100dvh - 4.5rem);
      overscroll-behavior: contain;
      overflow-y: auto;
      padding: 1rem var(--page-gutter) 1.5rem;
      position: absolute;
      right: 0;
      top: 100%;
    }

    .site-nav[data-open="true"] { display: grid; }

    .site-nav__group + .site-nav__group {
      border-top: 1px solid var(--color-border);
      padding-top: 1.25rem;
    }

    .site-nav__label { font-size: 0.72rem; margin-bottom: 0.35rem; }
    .site-nav ul { gap: 0.1rem; }
    .site-nav a { font-size: 0.94rem; min-height: 2.75rem; padding: 0.72rem 0.8rem; }

    .site-header__actions {
      border-top: 0;
      gap: 0.35rem;
      margin-top: 0;
      padding-top: 0;
    }

    .site-menu-toggle {
      align-items: center;
      background: transparent;
      border: 1px solid var(--color-border-strong);
      border-radius: var(--radius-control);
      color: var(--color-ink);
      cursor: pointer;
      display: inline-flex;
      font-size: 0.78rem;
      font-weight: 720;
      gap: 0.35rem;
      min-height: 2.55rem;
      padding: 0.5rem 0.65rem;
    }

    .site-menu-toggle svg {
      fill: none;
      height: 1rem;
      stroke: currentColor;
      stroke-linecap: round;
      stroke-width: 1.7;
      width: 1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-nav a { transition: none; }
  }
</style>
