---
import Logo from "@/components/common/Logo.astro";
---

<footer class="site-footer">
  <div class="site-footer__inner page-shell">
    <Logo compact />
    <nav aria-label="頁尾導覽">
      <a href="/about/">關於</a>
      <a href="/sources/">資料來源</a>
      <a href="https://github.com/kyeunga25/anisonary/issues/new?template=catalog-correction.yml" target="_blank" rel="noopener noreferrer">回報資料</a>
    </nav>
    <p>不託管音樂或影片，只連接官方與正版渠道。</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-border);
    margin-top: 2rem;
  }

  .site-footer__inner {
    align-items: center;
    display: grid;
    gap: 1rem;
    grid-template-columns: auto 1fr;
    min-height: 5rem;
    padding-block: 1rem;
  }

  .site-footer nav { display: flex; gap: 1.2rem; font-size: 0.8rem; justify-self: end; }
  .site-footer a { color: var(--color-muted); text-decoration: none; }
  .site-footer a:hover { color: var(--color-accent); }
  .site-footer p { color: var(--color-muted); font-size: 0.72rem; grid-column: 1 / -1; margin: 0; }

  @media (max-width: 720px) {
    .site-footer__inner {
      align-items: start;
      grid-template-columns: 1fr;
      padding-block: 2.2rem;
    }

    .site-footer nav, .site-footer p { justify-self: start; }
  }
</style>
