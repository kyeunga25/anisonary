---
import type { PublicTheme } from "@/types/public-api";
import { creditRoleLabel, themeTypeLabel } from "@/utils/theme";
import { themeVideoAnchor } from "@/utils/youtube";
import { seasonIdLabel } from "@/utils/season";
import { buildThemeSearchText } from "@/utils/catalog-search";
import ExternalLinkList from "@/components/links/ExternalLinkList.astro";
import LazyYouTube from "@/components/youtube/LazyYouTube.astro";
import SongRelations from "@/components/theme/SongRelations.astro";
import ThemeDataStatus from "@/components/theme/ThemeDataStatus.astro";

interface Props { theme: PublicTheme; }
const { theme } = Astro.props;
const credits = theme.credits.filter((credit) =>
  credit.role !== "vocals" || credit.name !== theme.artistDisplayName
);
const lastVerifiedAt = theme.sources
  .map((source) => source.verifiedAt)
  .sort((left, right) => right.localeCompare(left))[0];
const sourceLanguageLabels = {
  "zh-Hant": "繁中",
  "zh-Hans": "簡中",
  ja: "日文",
  en: "英文",
  multi: "多語"
} as const;
const sourceRoleLabels = {
  first_party: "第一方",
  cross_check: "交叉核對"
} as const;
---

<article class="theme-card" id={`theme-${theme.id}`} data-theme-type={theme.type} data-theme-search={buildThemeSearchText(theme)}>
  {theme.idAliases?.map((id) => <span class="theme-card__alias" id={`theme-${id}`} aria-hidden="true"></span>)}
  <div class="theme-card__summary">
    <div class:list={["theme-card__type", `theme-card__type--${theme.type.toLowerCase()}`]} aria-label={themeTypeLabel(theme)}>
      <strong>{themeTypeLabel(theme)}</strong>
    </div>

    <div class="theme-card__identity">
      <h3 lang="ja">{theme.titleJa}</h3>
      {theme.titleZhHant && <p class="theme-card__translation">{theme.titleZhHant}</p>}
      <p class="theme-card__artist">{theme.artistDisplayName}</p>
      {theme.usageLabel && <p class="theme-card__version">用途：{theme.usageLabel}</p>}
      {theme.seasonIds && <p class="theme-card__version">{theme.seasonIds.length ? `已確認用途季度：${theme.seasonIds.map(seasonIdLabel).join("、")}` : "用途季度待核對"}</p>}
      {theme.versionLabel && <p class="theme-card__version">{theme.versionLabel}</p>}
    </div>

  </div>

  <details class="theme-card__details">
    <summary aria-label={`${theme.titleJa}：查看歌曲詳情`}>
      <strong>歌曲詳情 <span lang="en">Details</span></strong>
      <span class="theme-card__detail-counts">{[
        credits.length && `${credits.length} 項名單`,
        theme.recordings?.length && `${theme.recordings.length} 個音源`,
        theme.releases?.length && `${theme.releases.length} 個發行版`,
        theme.videos.length && `${theme.videos.length} 支影片`,
        `${theme.sources.length} 個來源`
      ].filter(Boolean).join(" · ")}</span>
    </summary>
    {theme.dataStatus && <ThemeDataStatus status={theme.dataStatus} />}
    <div class="theme-card__detail-body">
    <dl class="theme-card__credits">
      {credits.length > 0 ? credits.map((credit) => (
        <div><dt>{creditRoleLabel(credit.role)}</dt><dd>{credit.name}{credit.groupName && `（${credit.groupName}）`}</dd></div>
      )) : (
        <div><dt>Credits</dt><dd>待確認</dd></div>
      )}
    </dl>

    <div class="theme-card__verification">
      <p class="theme-card__review-state">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 3h9l4 4v14H6zM14 3v5h5M9 13h7M9 17h7" /></svg>
        <span>審閱狀態：已審閱</span>
      </p>
      <p class="theme-card__review-state">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 7v6l4 2" /></svg>
        <span>最後驗證：{lastVerifiedAt ?? "待確認"}</span>
      </p>
      <ul aria-label="歌曲核對來源">
        {theme.sources.map((source) => (
          <li>
            <a href={source.url} target="_blank" rel="noopener noreferrer external">
              {source.label}
              <span class="sr-only">（在新分頁開啟外部網站）</span>
            </a>
            <span class="theme-card__source-meta">
              {sourceLanguageLabels[source.language]} · {sourceRoleLabels[source.role]}
              · {source.verifiedAt}
            </span>
          </li>
        ))}
      </ul>
    </div>
    </div>

  {(theme.recordings || theme.releases || theme.evidence) && <SongRelations theme={theme} />}

  {(theme.videos.length > 0 || theme.links.length > 0) && (
    <div class="theme-card__media">
      {theme.videos.map((video) => <div id={themeVideoAnchor(theme, video.youtubeVideoId)} class="theme-card__video"><LazyYouTube video={video} /></div>)}
      {theme.links.length > 0 && <div class="theme-card__links"><ExternalLinkList links={theme.links} /></div>}
    </div>
  )}
  </details>
</article>

<style>
  .theme-card { border-bottom: 1px solid var(--color-border); padding-block: 0.7rem 1rem; scroll-margin-top: 5rem; }
  .theme-card__alias { display: block; scroll-margin-top: 5rem; }
  .theme-card + .theme-card { margin-top: 1.2rem; }
  .theme-card__summary { align-items: start; display: grid; gap: 0.8rem 1rem; grid-template-columns: 3.5rem minmax(0, 1fr) minmax(0, 0.85fr); }
  .theme-card__type { background: color-mix(in srgb, var(--color-accent) 10%, transparent); border-radius: 4px; color: var(--color-accent); justify-self: start; margin-top: 0.15rem; padding: 0.3rem 0.5rem; }
  .theme-card__type--ed { background: color-mix(in srgb, var(--color-muted) 10%, transparent); color: var(--color-muted); }
  .theme-card__type strong { font-size: 0.9rem; }
  .theme-card__identity { grid-column: 2 / -1; min-width: 0; }
  .theme-card__identity h3 { font-size: clamp(1.2rem, 2vw, 1.6rem); line-height: 1.3; margin: 0; overflow-wrap: anywhere; }
  .theme-card__translation { color: var(--color-muted); font-size: 0.8rem; margin: 0.25rem 0 0; }
  .theme-card__artist { color: var(--color-muted); font-size: 0.95rem; line-height: 1.5; margin: 0.2rem 0 0; }
  .theme-card__version { color: var(--color-muted); font-size: 0.75rem; margin: 0.3rem 0 0; }
  .theme-card__details { margin-top: 0.5rem; }
  .theme-card__details > summary { align-items: baseline; cursor: pointer; display: list-item; font-size: 0.78rem; line-height: 1.8; padding-block: 0.4rem; }
  .theme-card__details > summary::marker { color: var(--color-accent); }
  .theme-card__details > summary strong { font-weight: 600; }
  .theme-card__details > summary strong span { color: var(--color-muted); font-size: 0.68rem; font-weight: 400; margin-left: 0.3rem; }
  .theme-card__detail-counts { color: var(--color-muted); display: inline-block; font-size: 0.7rem; margin-left: 0.8rem; overflow-wrap: anywhere; }
  .theme-card__detail-body { align-items: start; border-top: 1px solid var(--color-border); display: grid; gap: 1rem; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); margin-top: 0.4rem; padding-top: 0.6rem; }
  .theme-card__credits { display: grid; gap: 0.25rem; margin: 0; padding-block: 0.5rem; }
  .theme-card__credits div { display: grid; font-size: 0.78rem; gap: 0.65rem; grid-template-columns: 3.5rem minmax(0, 1fr); line-height: 1.65; }
  .theme-card__credits dt { color: var(--color-muted); }
  .theme-card__credits dd { margin: 0; overflow-wrap: anywhere; }
  .theme-card__verification { border-left: 1px solid var(--color-border); font-size: 0.73rem; padding: 0.5rem 0 0.5rem 1rem; }
  .theme-card__review-state { align-items: center; color: var(--color-muted); display: flex; gap: 0.4rem; margin: 0.1rem 0 0.4rem; }
  .theme-card__verification svg { fill: none; flex: none; height: 0.9rem; stroke: currentColor; stroke-width: 1.5; width: 0.9rem; }
  .theme-card__verification ul { display: grid; gap: 0.3rem; list-style: none; margin: 0.5rem 0 0; padding: 0; }
  .theme-card__verification li { align-items: baseline; display: flex; flex-wrap: wrap; gap: 0.2rem 0.4rem; }
  .theme-card__verification a { color: var(--color-accent); overflow-wrap: anywhere; text-underline-offset: 0.2em; }
  .theme-card__source-meta { color: var(--color-muted); font-size: 0.65rem; }
  .theme-card__media { margin-top: 0.8rem; }
  .theme-card__video { scroll-margin-top: 5rem; }
  .theme-card__video + .theme-card__video { margin-top: 0.6rem; }
  .theme-card__links { padding-top: 0.75rem; }
  @media (max-width: 660px) {
    .theme-card__summary { grid-template-columns: 3rem minmax(0, 1fr); }
    .theme-card__detail-body { grid-template-columns: 1fr; gap: 0.5rem; }
    .theme-card__detail-counts { display: block; margin-left: 0; }
    .theme-card__verification { border-left: 0; border-top: 1px solid var(--color-border); padding: 0.7rem 0 0; }
    .theme-card__identity h3 { font-size: 1.2rem; }
  }
</style>
