---
import type { PublicTheme } from "@/types/public-api";
import { creditRoleLabel } from "@/utils/theme";
import ExternalLinkList from "@/components/links/ExternalLinkList.astro";
import CreatorSearchLink from "@/components/links/CreatorSearchLink.astro";
import LazyYouTube from "@/components/youtube/LazyYouTube.astro";

interface Props { theme: PublicTheme; }
const { theme } = Astro.props;
const credits = theme.credits.filter((credit) =>
  credit.role !== "vocals" || credit.name !== theme.artistDisplayName
);
const creditGroups = new Map<PublicTheme["credits"][number]["role"], string[]>();
for (const credit of credits) {
  const names = creditGroups.get(credit.role) ?? [];
  names.push(credit.name);
  creditGroups.set(credit.role, names);
}
const repeatsVocalList = creditGroups.get("vocals")?.join("、") === theme.artistDisplayName;
if (repeatsVocalList) creditGroups.delete("vocals");
const collapsibleSources = theme.sources.length > 3;
const SourceSection = collapsibleSources ? "details" : "div";
const SourceHeading = collapsibleSources ? "summary" : "div";
const lastVerifiedAt = theme.sources
  .map((source) => source.verifiedAt)
  .sort((left, right) => right.localeCompare(left))[0];
const sourceLanguageLabels = {
  "zh-Hant": "繁中",
  "zh-Hans": "簡中",
  ja: "日文",
  en: "英文",
  multi: "多語"
} as const;
const sourceRoleLabels = {
  first_party: "第一方",
  cross_check: "交叉核對"
} as const;
---

<article class="theme-card" id={`theme-${theme.id}`} tabindex="-1">
  <div class:list={["theme-card__summary", { "theme-card__summary--compact": theme.sources.length <= 3 }]}>
    <div class:list={["theme-card__type", `theme-card__type--${theme.type.toLowerCase()}`]} aria-label={`${theme.type} ${theme.sequence}`}>
      <strong>{theme.type}{theme.sequence}</strong>
      <svg viewBox="0 0 48 48" aria-hidden="true">
        {theme.type === "OP" ? (
          <><circle cx="24" cy="24" r="7" /><path d="M24 4v8M24 36v8M4 24h8M36 24h8M10 10l6 6M32 32l6 6M38 10l-6 6M16 32l-6 6" /></>
        ) : (
          <><path d="M10 30c14-2 20-11 28-21 1 18-8 29-23 30" /><path d="M13 37c8-8 14-13 25-20" /></>
        )}
      </svg>
    </div>

    <div class="theme-card__identity">
      <h3 lang="ja">{theme.titleJa}</h3>
      {theme.titleZhHant && <p class="theme-card__translation">{theme.titleZhHant}</p>}
      <p class="theme-card__artist"><CreatorSearchLink name={theme.artistDisplayName} /></p>
      {theme.versionLabel && <p class="theme-card__version">{theme.versionLabel}</p>}
      {theme.releaseDate && <p class="theme-card__release-date">發行日期 <time datetime={theme.releaseDate}>{theme.releaseDate}</time></p>}
    </div>

    <dl class="theme-card__credits">
      {creditGroups.size > 0 ? [...creditGroups].map(([role, names]) => (
        <div><dt>{creditRoleLabel(role)}</dt><dd>{names.map((name, index) => <>{index > 0 && "、"}<CreatorSearchLink name={name} /></>)}</dd></div>
      )) : (
        <div><dt>{repeatsVocalList ? "製作" : "Credits"}</dt><dd>待確認</dd></div>
      )}
    </dl>

    <SourceSection class:list={["theme-card__verification", { "theme-card__verification--collapsible": collapsibleSources }]}>
      <SourceHeading class="theme-card__review-meta">
        <span class="theme-card__source-heading">核對來源{collapsibleSources && `（${theme.sources.length}）`}</span>
        <span class="theme-card__review-state">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 3h9l4 4v14H6zM14 3v5h5M9 13h7M9 17h7" /></svg>
          <span>審閱狀態：已審閱</span>
        </span>
        <span class="theme-card__review-state">
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 7v6l4 2" /></svg>
          <span>最後驗證：{lastVerifiedAt ?? "待確認"}</span>
        </span>
        {collapsibleSources && (
          <span class="theme-card__source-toggle">
            <span class="theme-card__source-expand">展開</span>
            <span class="theme-card__source-collapse">收合</span>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
          </span>
        )}
      </SourceHeading>
      <ul aria-label="歌曲核對來源">
        {theme.sources.map((source) => (
          <li>
            <a href={source.url} target="_blank" rel="noopener noreferrer external">
              {source.label}
              <span class="sr-only">（在新分頁開啟外部網站）</span>
            </a>
            <span class="theme-card__source-meta">
              {sourceLanguageLabels[source.language]} · {sourceRoleLabels[source.role]}
            </span>
          </li>
        ))}
      </ul>
    </SourceSection>
  </div>

  {(theme.videos.length > 0 || theme.links.length > 0) && (
    <div class="theme-card__media">
      {theme.videos.map((video) => <LazyYouTube video={video} />)}
      {theme.links.length > 0 && <div class="theme-card__links"><ExternalLinkList links={theme.links} /></div>}
    </div>
  )}
</article>

<style>
  .theme-card { scroll-margin-top: 6rem; }
  .theme-card { background: var(--color-surface); border: 1px solid var(--color-border-strong); border-radius: var(--radius-card); overflow: hidden; }
  .theme-card:target { border-color: var(--color-focus); }
  .theme-card + .theme-card { margin-top: 0.8rem; }
  .theme-card__summary { display: grid; grid-template-columns: 5rem minmax(0, 1.3fr) minmax(0, 1fr); }
  .theme-card__type { align-items: center; background: var(--color-accent); color: var(--color-on-accent); display: flex; flex-direction: column; justify-content: center; padding: 1rem; }
  .theme-card__type--ed { background: color-mix(in srgb, var(--color-accent) 86%, var(--color-ink)); }
  .theme-card__type strong { font-size: 1.35rem; }
  .theme-card__type svg { fill: none; height: 2.25rem; margin-top: 0.45rem; stroke: currentColor; stroke-linecap: round; stroke-width: 1.5; width: 2.25rem; }
  .theme-card__identity, .theme-card__credits, .theme-card__verification { align-self: stretch; min-width: 0; overflow-wrap: anywhere; padding: 1.35rem 1.5rem; }
  .theme-card__identity { display: flex; flex-direction: column; justify-content: center; }
  .theme-card__identity h3 { font-size: clamp(1.25rem, 2vw, 1.7rem); line-height: 1.25; margin: 0; }
  .theme-card__translation { color: var(--color-muted); font-size: 0.82rem; margin: 0.25rem 0 0; }
  .theme-card__artist { font-size: 1rem; font-weight: 720; margin: 0.8rem 0 0; }
  .theme-card__version { color: var(--color-muted); font-size: 0.75rem; margin: 0.35rem 0 0; }
  .theme-card__release-date { color: var(--color-muted); display: flex; flex-wrap: wrap; font-size: 0.75rem; gap: 0.25rem 0.5rem; margin: 0.35rem 0 0; }
  .theme-card__credits { border-left: 1px solid var(--color-border); display: flex; flex-direction: column; justify-content: center; margin: 1.1rem 0; padding-block: 0.2rem; }
  .theme-card__credits div { display: grid; font-size: 0.82rem; gap: 0.55rem; grid-template-columns: 3.2rem 1fr; line-height: 1.55; }
  .theme-card__credits dt { color: var(--color-muted); }
  .theme-card__credits dd { margin: 0; }
  .theme-card__verification { border-top: 1px solid var(--color-border); font-size: 0.78rem; grid-column: 1 / -1; padding-block: 1rem; }
  .theme-card__review-meta { align-items: center; display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; }
  .theme-card__verification--collapsible > summary { cursor: pointer; list-style: none; min-height: 2.75rem; }
  .theme-card__verification--collapsible > summary::-webkit-details-marker { display: none; }
  .theme-card__source-toggle { align-items: center; color: var(--color-ink); display: flex; font-weight: 680; gap: 0.4rem; margin-left: auto; }
  .theme-card__verification:not([open]) .theme-card__source-collapse, .theme-card__verification[open] .theme-card__source-expand { display: none; }
  .theme-card__verification[open] .theme-card__source-toggle svg { transform: rotate(180deg); }
  .theme-card__source-heading { font-size: 0.82rem; font-weight: 740; margin: 0; }
  .theme-card__review-state { align-items: center; color: var(--color-muted); display: flex; gap: 0.55rem; margin: 0; }
  .theme-card__verification svg { fill: none; flex: 0 0 auto; height: 1.15rem; stroke: currentColor; stroke-width: 1.5; width: 1.15rem; }
  .theme-card__verification ul { display: grid; gap: 0.35rem 1.25rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr)); list-style: none; margin: 0.8rem 0 0; padding: 0; }
  .theme-card__verification li { align-items: baseline; display: flex; flex-wrap: wrap; gap: 0.25rem 0.45rem; min-width: 0; }
  .theme-card__verification a { color: var(--color-accent); font-weight: 680; text-underline-offset: 0.16em; }
  .theme-card__source-meta { color: var(--color-muted); font-size: 0.68rem; }
  .theme-card__media { border-top: 1px solid var(--color-border); }
  .theme-card__links { padding: 0 1.3rem 1.3rem; }

  @media (min-width: 941px) {
    .theme-card__summary--compact { grid-template-columns: 5rem minmax(0, 1.3fr) minmax(0, 1fr) minmax(0, 1fr); min-height: 9rem; }
    .theme-card__summary--compact .theme-card__verification { border-left: 1px solid var(--color-border); border-top: 0; display: flex; flex-direction: column; grid-column: auto; justify-content: center; margin: 1.1rem 0; padding-block: 0.2rem; }
    .theme-card__summary--compact .theme-card__review-meta { display: block; }
    .theme-card__summary--compact .theme-card__source-heading { display: none; }
    .theme-card__summary--compact .theme-card__review-state { margin: 0.3rem 0; }
    .theme-card__summary--compact .theme-card__verification ul { grid-template-columns: minmax(0, 1fr); margin-top: 0.65rem; }
  }

  @media (max-width: 940px) {
    .theme-card__summary { grid-template-columns: 5rem minmax(0, 1fr) minmax(0, 1fr); }
  }

  @media (max-width: 660px) {
    .theme-card__summary { grid-template-columns: 4.6rem 1fr; }
    .theme-card__identity { padding: 1.15rem; }
    .theme-card__credits, .theme-card__verification { border-left: 0; border-top: 1px solid var(--color-border); grid-column: 1 / -1; margin: 0; padding: 1rem 1.15rem; }
    .theme-card__verification--collapsible .theme-card__source-toggle { order: 1; }
    .theme-card__verification--collapsible .theme-card__review-state { flex-basis: 100%; order: 2; }
    .theme-card__links { padding: 0 1rem 1rem; }
  }
</style>
