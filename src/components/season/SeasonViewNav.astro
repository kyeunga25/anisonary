---
import type { PublicSeasonSummary } from "@/types/public-api";
interface Props { season: PublicSeasonSummary; current: "songs" | "anime"; }
const { season, current } = Astro.props;
---
<nav class="season-views" aria-label="季度展示方式">
  <a href={`/seasons/${season.id}/`} aria-current={current === "songs" ? "page" : undefined}>歌曲列表 <small lang="en">Playlist</small></a>
  <a href={`/seasons/${season.id}/anime/`} aria-current={current === "anime" ? "page" : undefined}>動畫海報牆 <small lang="en">Anime</small></a>
</nav>
<style>
  .season-views { border-bottom: 1px solid var(--color-border); display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; margin-block: 1rem; }
  a { border-bottom: 2px solid transparent; color: var(--color-muted); font-size: 0.85rem; font-weight: 600; min-height: 2.75rem; padding: 0.65rem 0; text-decoration: none; }
  a[aria-current] { border-color: var(--color-accent); color: var(--color-ink); }
  a:hover { color: var(--color-accent); }
  small { font-size: 0.68rem; font-weight: 400; margin-left: 0.35rem; }
</style>
